/* SPDX-License-Identifier: GPL-2.0-or-later
   Look mockup B "Modern": rounded panel cards on the window background, location
   row with drive chip, quiet bottom row, menu button instead of the menu bar. */
QToolBar { border: none; padding: 4px 8px; spacing: 3px; }
QToolBar QToolButton { border-radius: 7px; padding: 4px; }
QMainWindow::separator { width: 6px; height: 6px; background: transparent; }

KrInterDetailedView, KrInterThumbnailView {
    border: 1px solid palette(midlight); border-radius: 10px; padding: 3px; background: palette(base);
}
QHeaderView { background: transparent; }
QHeaderView::section {
    background: palette(base); color: #8a9199;
    border: none; border-bottom: 1px solid palette(midlight); padding: 5px 8px;
}
QHeaderView::section:hover { color: palette(text); }

ListPanelFrame { border: none; border-radius: 7px; padding: 2px 8px; margin-top: 3px; }
MediaButton {
    border: 1px solid palette(midlight); border-radius: 7px; padding: 3px 8px; margin: 2px 4px 2px 0;
    background: palette(base);
}
KUrlNavigator { margin: 2px 0; }

PanelTabBar::tab { border: none; padding: 4px 14px; margin: 3px 2px 0 0; border-radius: 7px; background: transparent; color: #8a9199; }
PanelTabBar::tab:selected { background: palette(base); color: palette(text); border: 1px solid palette(midlight); }

KFnKeys QPushButton { border: none; border-radius: 7px; padding: 5px 2px; background: transparent; color: palette(window-text); }
KFnKeys QPushButton:hover { background: palette(base); }

#panero_navigation_dock QListWidget, #panero_navigation_dock KrFileTreeView {
    border: none; background: palette(window);
}
#panero_navigation_dock QListWidget::item, #panero_navigation_dock KrFileTreeView::item { padding: 4px 2px; border-radius: 7px; }
#panero_navigation_dock QListWidget::item:selected, #panero_navigation_dock KrFileTreeView::item:selected {
    background: palette(highlight); color: palette(highlighted-text);
}
#panero_navigation_dock QListWidget::item:hover:!selected, #panero_navigation_dock KrFileTreeView::item:hover:!selected { background: palette(midlight); }
QStatusBar { border: none; }
QStatusBar QLabel { padding: 2px 8px; color: #8a9199; }

ListPanelFrame[active="true"] { background: palette(highlight); }
ListPanelFrame[active="true"] QLabel, ListPanelFrame[active="true"] QToolButton { color: palette(highlighted-text); }
ListPanelFrame[active="false"] { background: transparent; }
ListPanelFrame[active="false"] QLabel { color: palette(window-text); }
KrInterDetailedView:focus, KrInterThumbnailView:focus { border: 1px solid palette(highlight); }
