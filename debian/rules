#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Panero contributors
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Panero is packaged from its own upstream repository (debian/ lives in the
# source tree). Source format is 3.0 (quilt) rather than native because the
# version carries a Debian revision (0.1.0~preview.1-1, dev/DECISIONS.md
# D-003); see debian/README.source.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
PANERO_BUILD_TESTING = OFF
else
PANERO_BUILD_TESTING = ON
endif

%:
	dh $@ --buildsystem=cmake+ninja

# RelWithDebInfo matches CI and the documented upstream build; the compiler
# and linker flags from dpkg-buildflags (hardening etc.) are still applied
# through CFLAGS/CXXFLAGS/LDFLAGS.
# Panero ships its own, pinned rclone (dev/CLOUD-SECURITY-AUDIT.md R1, D-016):
# dev/scripts/build-deb.sh fetches and verifies it (dev/scripts/fetch-rclone.sh)
# into debian/rclone/ before the build. Release builds check that it is there
# (dev/scripts/test-deb.sh).
PANERO_RCLONE_DIR = $(CURDIR)/debian/rclone
ifneq (,$(wildcard $(PANERO_RCLONE_DIR)/rclone))
PANERO_RCLONE_FLAGS = -DPANERO_RCLONE_BINARY=$(PANERO_RCLONE_DIR)/rclone
endif

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DBUILD_TESTING=$(PANERO_BUILD_TESTING) \
		$(PANERO_RCLONE_FLAGS)

override_dh_auto_install:
	dh_auto_install
ifneq (,$(wildcard $(PANERO_RCLONE_DIR)/rclone))
	install -D -m 0644 $(PANERO_RCLONE_DIR)/COPYING debian/panero/usr/share/doc/panero/rclone/COPYING
	install -D -m 0644 $(PANERO_RCLONE_DIR)/rclone-dependencies.txt debian/panero/usr/share/doc/panero/rclone/dependencies.txt
endif

# The rclone binary is the verified upstream build: keep it byte for byte.
override_dh_strip:
	dh_strip -Xlibexec/panero/rclone

override_dh_dwz:
	dh_dwz -Xlibexec/panero/rclone

# KDE's help system (help:/panero, KHelpCenter) reads the handbook docbook
# files uncompressed, as in the Ubuntu krusader package.
override_dh_compress:
	dh_compress -X.docbook -Xrclone/dependencies.txt

# The autotests are headless QtTest programs; dh_auto_test already provides
# an isolated HOME and XDG_RUNTIME_DIR.
override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen dh_auto_test
