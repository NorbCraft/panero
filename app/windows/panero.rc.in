// Windows resources: application icon (Explorer, taskbar, Alt+Tab) and version info.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/windows/panero.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Panero contributors"
            VALUE "FileDescription", "Panero twin-panel file manager"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "panero"
            VALUE "LegalCopyright", "GPL-2.0-or-later. Based on Krusader."
            VALUE "OriginalFilename", "panero.exe"
            VALUE "ProductName", "Panero"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
